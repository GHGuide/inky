# Fill these in yourself. Never paste keys into chat.

# GLM-5.3 for plan / compile / repair. Key: https://openrouter.ai/settings/keys ($5 credit is plenty)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3

# Apify: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# n8n Pro: Settings -> n8n API -> Create an API key. Base URL looks like https://<name>.app.n8n.cloud
N8N_BASE_URL=
N8N_API_KEY=
# Only if n8n API is missing: Settings -> Instance-level MCP -> Enable -> Connect -> API key tab
N8N_MCP_URL=
N8N_MCP_TOKEN=

# Telegram: message @BotFather, /newbot, paste token. Then send /start to your bot.
TELEGRAM_BOT_TOKEN=
