# Optional. Inky reads a .env file in the folder you start it from (python -m inky), as a fallback for keys
# you'd rather not paste into the app. Keys you paste in the app are kept in your system keychain (macOS) or in
# a file only you can read in your Inky folder (Windows, Linux). Never commit a filled-in .env.

# Where Inky keeps its data, and which address it listens on (defaults shown)
# INKY_HOME=~/.inky
# INKY_PORT=8800

# Model keys: any one is enough, or none if you use a local model with Ollama
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=

# Optional services
# TELEGRAM_BOT_TOKEN=
# APIFY_TOKEN=
# N8N_API_KEY=
