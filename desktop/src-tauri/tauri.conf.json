{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inky",
  "version": "0.1.0",
  "identifier": "org.inky.app",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Always-on bots that learn once, then repeat with no AI",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/inky-engine"],
    "fileAssociations": [
      { "ext": ["inky"], "name": "Inky bot", "description": "An Inky bot file", "role": "Viewer" },
      { "ext": ["inkyskill"], "name": "Inky skill", "description": "An Inky skill file", "role": "Viewer" }
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
