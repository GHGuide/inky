{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inky",
  "version": "0.1.2",
  "identifier": "io.github.ghguide.inky",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Always-on bots that learn once, then repeat with no AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/inky-engine"
    ],
    "fileAssociations": [
      {
        "ext": [
          "inky"
        ],
        "name": "Inky bot",
        "description": "An Inky bot file",
        "role": "Viewer"
      },
      {
        "ext": [
          "inkyskill"
        ],
        "name": "Inky skill",
        "description": "An Inky skill file",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "publisher": "Inky contributors",
    "copyright": "Copyright © 2026 Inky contributors. MIT License.",
    "homepage": "https://github.com/GHGuide/inky",
    "license": "MIT",
    "longDescription": "Bots that watch and work the web for you. Describe a job in plain words; a bot learns the site once with AI, then repeats it on a schedule with no AI, on your own computer, and asks before anything it can't undo."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "inky"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1NkJGOUZGQ0U1OTk4RjMKUldUem1Gbk8vL2xyNVd2eFBieVB6emtDSjlSU0lxcHhVTmFtRzk5am5ucys5dEh3UjA3NkxkaFcK",
      "endpoints": [
        "https://github.com/GHGuide/inky/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
