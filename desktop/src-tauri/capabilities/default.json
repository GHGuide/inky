{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The app windows talk to this side only from the local engine they show.",
  "windows": [
    "main",
    "bar",
    "buddy"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "autostart:default",
    "allow-tray",
    "allow-notify",
    "allow-bar",
    "allow-open-needs",
    "allow-autostart",
    "allow-app-info",
    "allow-open-url"
  ]
}
